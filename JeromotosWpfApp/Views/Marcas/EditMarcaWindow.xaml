<Window x:Class="JeromotosWpfApp.Views.Marcas.EditMarcaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JeromotosWpfApp.Views.Marcas"
        mc:Ignorable="d"
        Title=""
        Height="450"
        Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid Margin="20">

            <Border Background="{StaticResource CardBackground}"
             CornerRadius="15"
             Padding="25">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                         Margin="0,0,0,25">

                        <TextBlock Text="Editar Marca"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock Text="Actualizar información de la marca"
                            Margin="0,5,0,0"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryText}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="1">

                        <TextBlock Text="Nombre"
                            Style="{StaticResource LabelText}"/>

                        <TextBox x:Name="txtNombre"
                          HorizontalAlignment="Stretch"
                          Tag="Nombre de la marca"
                          Style="{StaticResource ModernTextBox}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="2"
                         Margin="0,20,0,0">

                        <TextBlock Text="Estado"
                            Style="{StaticResource LabelText}"/>

                        <CheckBox x:Name="chkActivo"
                           Content="Activo"
                           Style="{StaticResource ModernCheckBox}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="3"
                         Orientation="Horizontal"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,25,0,0">

                        <Button Content="Cancelar"
                         Width="120"
                         Style="{StaticResource SecondaryButton}"
                         Click="BtnCancel_Click"/>

                        <Button Content="Guardar"
                         Width="120"
                         Margin="10,0,0,0"
                         Style="{StaticResource PrimaryButton}"
                         Click="BtnUpdate_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</Window>

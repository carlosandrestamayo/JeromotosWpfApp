<UserControl x:Class="JeromotosWpfApp.Views.DashBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JeromotosWpfApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="{StaticResource MainBackground}">

        <Border Style="{StaticResource CardStyle}"
                Margin="15"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Dashboard"
                           FontSize="35"
                           FontWeight="Bold"
                           Margin="10,0,0,20"
                           Foreground="{StaticResource PrimaryText}"/>

                <Border Grid.Row="1"
                        CornerRadius="15"
                        Margin="0,0,0,20"
                        ClipToBounds="True">

                    <Grid>

                        <Image Source="/Assets/jeromotos24-banner.png"
                               Stretch="UniformToFill"/>

                        <Border Background="#99000000"/>

                        <StackPanel VerticalAlignment="Center"
                                    Margin="30">

                            <TextBlock Text="JEROMOTOS 24"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Pasión por las motos"
                                       FontSize="16"
                                       Foreground="White"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="Sistema de gestión del taller"
                                       FontSize="13"
                                       Foreground="#E5E7EB"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <UniformGrid Grid.Row="2"
                             Columns="4"
                             Margin="0,0,0,20">

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Clientes"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryText}"/>

                            <TextBlock x:Name="txtTotalClientes"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryColor}"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Registrados"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Motocicletas"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryText}"/>

                            <TextBlock x:Name="txtTotalMotos"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessColor}"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Registradas"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Marcas"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryText}"/>

                            <TextBlock x:Name="txtTotalMarcas"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningColor}"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Disponibles"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Servicios"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryText}"/>

                            <TextBlock x:Name="txtTotalServicios"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerColor}"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Disponibles"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="20"
                            Margin="5,0,10,0">

                        <StackPanel>

                            <TextBlock Text="Bienvenido a Jeromotos24"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock Text="Sistema de gestión del taller"
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,5,0,20"/>

                            <TextBlock Text="Resumen del sistema"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Grid Margin="0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Clientes registrados"
                                           Foreground="{StaticResource SecondaryText}"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="txtResumenClientes"
                                           FontWeight="Bold"/>

                            </Grid>

                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Motocicletas registradas"
                                           Foreground="{StaticResource SecondaryText}"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="txtResumenMotos"
                                           FontWeight="Bold"/>

                            </Grid>

                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Marcas registradas"
                                           Foreground="{StaticResource SecondaryText}"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="txtResumenMarcas"
                                           FontWeight="Bold"/>

                            </Grid>

                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Servicios disponibles"
                                           Foreground="{StaticResource SecondaryText}"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="txtResumenServicios"
                                           FontWeight="Bold"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="20"
                            Margin="10,0,5,0">

                        <StackPanel>

                            <TextBlock Text="Jeromotos24"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock Text="Gestión integral del taller"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,5,0,20"/>

                            <Border Background="{StaticResource MainBackground}"
                                    CornerRadius="12"
                                    Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Control"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Text="Clientes"
                                               Margin="0,4"/>

                                    <TextBlock Text="Motocicletas"
                                               Margin="0,4"/>

                                    <TextBlock Text="Marcas"
                                               Margin="0,4"/>

                                    <TextBlock Text="Referencias"
                                               Margin="0,4"/>

                                    <TextBlock Text="Servicios de taller"
                                               Margin="0,4"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
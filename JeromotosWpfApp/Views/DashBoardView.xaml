<UserControl x:Class="JeromotosWpfApp.Views.DashBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JeromotosWpfApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

        <Grid Background="{StaticResource MainBackground}">

        <Border Style="{StaticResource CardStyle}"
                Margin="15"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Dashboard"
                           FontSize="35"
                           FontWeight="Bold"
                           Margin="10,0,0,20"
                           Foreground="{StaticResource PrimaryText}"/>

                <UniformGrid Grid.Row="1"
                             Columns="4"
                             Margin="0,0,0,20">

                    <!-- CLIENTES -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5">

                        <StackPanel Margin="15">

                            <TextBlock Text="👥 Clientes"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="txtTotalClientes"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryColor}"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- MOTOS -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5">

                        <StackPanel Margin="15">

                            <TextBlock Text="🏍 Motos"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="txtTotalMotos"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessColor}"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- MARCAS -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5">

                        <StackPanel Margin="15">

                            <TextBlock Text="🏷 Marcas"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="txtTotalMarcas"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningColor}"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- SERVICIOS -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5">

                        <StackPanel Margin="15">

                            <TextBlock Text="🔧 Servicios"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="txtTotalServicios"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerColor}"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Información del taller"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Bienvenido a Jeromotos24"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Text="Sistema de gestión para el control de clientes, motocicletas y servicios de taller."
                                   Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   Margin="0,5"/>

                        <Separator Margin="0,15"/>

                        <TextBlock Text="Resumen"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <StackPanel>

                            <TextBlock>
                                <Run Text="Clientes registrados: "/>
                                <Run x:Name="txtResumenClientes"
                                     FontWeight="Bold"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0">
                                <Run Text="Motocicletas registradas: "/>
                                <Run x:Name="txtResumenMotos"
                                     FontWeight="Bold"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0">
                                <Run Text="Marcas registradas: "/>
                                <Run x:Name="txtResumenMarcas"
                                     FontWeight="Bold"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0">
                                <Run Text="Servicios disponibles: "/>
                                <Run x:Name="txtResumenServicios"
                                     FontWeight="Bold"/>
                            </TextBlock>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>
    


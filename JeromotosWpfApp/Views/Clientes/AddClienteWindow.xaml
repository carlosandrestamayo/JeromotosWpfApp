<Window x:Class="JeromotosWpfApp.Views.Clientes.AddClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JeromotosWpfApp.Views.Clientes"
        mc:Ignorable="d"
        Title="" 
        Height="730" 
        Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid>

            <Grid Margin="20">

                <Border Background="{StaticResource CardBackground}"
                    CornerRadius="15"
                    Padding="25">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                Margin="0,0,0,25">

                            <TextBlock Text="Agregar Cliente"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock Text="Registrar información del cliente"
                                   Margin="0,5,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                        <StackPanel Grid.Row="1">

                            <TextBlock Text="Nombre"
                                   Style="{StaticResource LabelText}"/>

                            <TextBox x:Name="txtNombre"
                                 Tag="Nombre completo"
                                 Style="{StaticResource ModernTextBox}"/>

                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                Margin="0,15,0,0">

                            <TextBlock Text="Documento"
                                   Style="{StaticResource LabelText}"/>

                            <TextBox x:Name="txtDocumento"
                                 Tag="Número de documento"
                                 Style="{StaticResource ModernTextBox}"/>

                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                Margin="0,15,0,0">

                            <TextBlock Text="Teléfono"
                                   Style="{StaticResource LabelText}"/>

                            <TextBox x:Name="txtTelefono"
                                 Tag="Número de teléfono"
                                 Style="{StaticResource ModernTextBox}"/>

                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                Margin="0,15,0,0">

                            <TextBlock Text="Correo electrónico"
                                   Style="{StaticResource LabelText}"/>

                            <TextBox x:Name="txtEmail"
                                 Tag="Correo electrónico"
                                 Style="{StaticResource ModernTextBox}"/>

                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                Margin="0,15,0,0">

                            <TextBlock Text="Dirección"
                                   Style="{StaticResource LabelText}"/>

                            <TextBox x:Name="txtDireccion"
                                 Tag="Dirección"
                                 Style="{StaticResource ModernTextBox}"/>

                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,25,0,0">

                                <Button Content="Cancelar"
                                    Width="120"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnCancel_Click"/>

                                <Button Content="Guardar"
                                    Width="120"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnSave_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Grid>
    </Window>
<UserControl x:Class="JeromotosWpfApp.Views.Referencias.ReferenciasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JeromotosWpfApp.Views.Referencias"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
        <Grid Background="{StaticResource MainBackground}">

            <Border Margin="15"
                Padding="20"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                           Text="Referencias"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"
                           Margin="0,0,0,20"/>

                    <Grid Grid.Row="1"
                      Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch"
                             Width="300"
                             HorizontalAlignment="Left"
                             Tag="Buscar referencia..."
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="TxtSearch_TextChanged"/>

                        <Button Grid.Column="1"
                            Content="Agregar referencia"
                            Width="160"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnAdd_Click"/>

                    </Grid>

                    <DataGrid x:Name="tableReferencias"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Marca"
                                            Binding="{Binding MarcaNombre}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Referencia"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Cilindraje"
                                            Binding="{Binding Cilindraje}"
                                            Width="120"/>

                            <DataGridTextColumn Header="Alimentación"
                                            Binding="{Binding Alimentacion}"
                                            Width="150"/>

                            <DataGridTextColumn Header="Estado"
                                            Binding="{Binding Estado}"
                                            Width="100"/>

                            <DataGridTemplateColumn Header="Acciones"
                                                Width="100">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Editar"
                                            Width="70"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnEdit_Click"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </UserControl>
